{
  "swagger": "2.0",
  "info": {
    "title": "stats-api.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "StatsService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/issuers/{issuerIdentity}/assets/{assetName}/owners": {
      "get": {
        "operationId": "StatsService_GetAssetOwners",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pbGetAssetOwnershipResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "issuerIdentity",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "assetName",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/latest-stats": {
      "get": {
        "summary": "Returns the latest available chain information.",
        "operationId": "StatsService_GetLatestData",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pbGetLatestDataResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/rich-list": {
      "get": {
        "summary": "Returns the list of top holders in the Qubic network.",
        "operationId": "StatsService_GetRichListSlice",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pbGetRichListSliceResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageSize",
            "description": "Value must be between 1 and 100",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/stats/supply-history": {
      "get": {
        "summary": "Returns the circulating supply per epoch, one point per completed epoch, ordered by epoch\nascending. The epoch in progress is reported separately as current_epoch.",
        "operationId": "StatsService_GetSupplyHistory",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pbGetSupplyHistoryResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "fromEpoch",
            "description": "Inclusive. Defaults to the earliest available epoch.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "toEpoch",
            "description": "Inclusive. Defaults to the latest available epoch.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "limit",
            "description": "Maximum number of points. The most recent ones are kept when the range holds more.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    }
  },
  "definitions": {
    "pbAssetOwnership": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "numberOfShares": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "pbGetAssetOwnershipResponse": {
      "type": "object",
      "properties": {
        "pagination": {
          "$ref": "#/definitions/pbPagination"
        },
        "tick": {
          "type": "integer",
          "format": "int64"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/pbAssetOwnership"
          }
        }
      }
    },
    "pbGetLatestDataResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/definitions/pbQubicData"
        }
      }
    },
    "pbGetRichListSliceResponse": {
      "type": "object",
      "properties": {
        "pagination": {
          "$ref": "#/definitions/pbPagination"
        },
        "epoch": {
          "type": "integer",
          "format": "int64"
        },
        "richList": {
          "$ref": "#/definitions/pbRichList"
        }
      }
    },
    "pbGetSupplyHistoryResponse": {
      "type": "object",
      "properties": {
        "supplyCap": {
          "type": "string",
          "format": "int64",
          "description": "Maximum amount of QUs that can ever exist. Constant, for a reference line."
        },
        "currentEpoch": {
          "type": "integer",
          "format": "int64"
        },
        "currentCirculatingSupply": {
          "type": "string",
          "format": "int64"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/pbSupplyHistoryPoint"
          },
          "description": "Ordered by epoch ascending."
        }
      }
    },
    "pbPagination": {
      "type": "object",
      "properties": {
        "totalRecords": {
          "type": "integer",
          "format": "int32"
        },
        "currentPage": {
          "type": "integer",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "pbQubicData": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "int64"
        },
        "circulatingSupply": {
          "type": "string",
          "format": "int64"
        },
        "activeAddresses": {
          "type": "integer",
          "format": "int32"
        },
        "price": {
          "type": "number",
          "format": "float"
        },
        "marketCap": {
          "type": "string",
          "format": "int64"
        },
        "epoch": {
          "type": "integer",
          "format": "int64"
        },
        "currentTick": {
          "type": "integer",
          "format": "int64"
        },
        "ticksInCurrentEpoch": {
          "type": "integer",
          "format": "int64"
        },
        "emptyTicksInCurrentEpoch": {
          "type": "integer",
          "format": "int64"
        },
        "epochTickQuality": {
          "type": "number",
          "format": "float"
        },
        "burnedQus": {
          "type": "string",
          "format": "uint64"
        },
        "ticksInLast10000": {
          "type": "integer",
          "format": "int64"
        },
        "emptyTicksInLast10000": {
          "type": "integer",
          "format": "int64"
        },
        "last10000TickQuality": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "pbRichList": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/pbRichListEntity"
          }
        }
      }
    },
    "pbRichListEntity": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "balance": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "pbSupplyHistoryPoint": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "integer",
          "format": "int64"
        },
        "circulatingSupply": {
          "type": "string",
          "format": "int64",
          "description": "Circulating supply at the end of this epoch, as measured by the spectrum file that was dumped\nat the transition into the next one."
        },
        "totalEmitted": {
          "type": "string",
          "format": "int64",
          "description": "Cumulative issuance up to and including this epoch."
        },
        "timestamp": {
          "type": "string",
          "format": "int64",
          "description": "When this epoch closed, in unix seconds. Display only."
        },
        "supplySource": {
          "type": "string",
          "description": "How the supply of this point was obtained. \"spectrum\" and \"derived\" are measured values,\n\"carried-over\" means that no spectrum file could be attributed to this epoch and the supply of\nan earlier one is repeated, which shows up as an epoch without any burn."
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  }
}
